<resources>

    <!-- 2.0 design system: light, quiet surfaces, one blue accent. -->
    <style name="KK" />
    <style name="AppTheme" parent="android:Theme.Material.Light">
        <item name="android:colorPrimary">@color/kk_bg</item>
        <item name="android:colorPrimaryDark">@color/kk_bg</item>
        <item name="android:colorAccent">@color/kk_primary</item>
        <item name="android:windowBackground">@color/kk_bg</item>
        <item name="android:textColorPrimary">@color/kk_text</item>
        <item name="android:textColorSecondary">@color/kk_text_secondary</item>
        <item name="android:colorControlNormal">@color/kk_text_secondary</item>
        <item name="android:actionBarStyle">@style/KK.ActionBar</item>
        <item name="android:buttonStyle">@style/KK.Button</item>
        <item name="android:alertDialogTheme">@style/KK.Dialog</item>
    </style>

    <style name="AppTheme.NoActionBar">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <style name="KK.ActionBar" parent="android:Widget.Material.Light.ActionBar.Solid">
        <item name="android:background">@color/kk_bg</item>
        <item name="android:elevation">0dp</item>
        <item name="android:titleTextStyle">@style/KK.ActionBarTitle</item>
    </style>

    <style name="KK.ActionBarTitle" parent="android:TextAppearance.Material.Widget.ActionBar.Title">
        <item name="android:textColor">@color/kk_text</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="KK.Button" parent="android:Widget.Material.Button">
        <item name="android:background">@drawable/kk_btn_tonal</item>
        <item name="android:textColor">@color/kk_primary_dark</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="KK.Button.Primary">
        <item name="android:background">@drawable/kk_btn_primary</item>
        <item name="android:textColor">@android:color/white</item>
    </style>

    <style name="KK.Dialog" parent="android:Theme.Material.Light.Dialog.Alert">
        <item name="android:colorAccent">@color/kk_primary</item>
    </style>

    <style name="KK.Title">
        <item name="android:textColor">@color/kk_text</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="KK.Body">
        <item name="android:textColor">@color/kk_text</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="KK.Caption">
        <item name="android:textColor">@color/kk_text_secondary</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="KK.MenuRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">64dp</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:background">@drawable/kk_menu_row</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="KK.MenuIcon">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:layout_marginEnd">16dp</item>
        <item name="android:padding">8dp</item>
        <item name="android:background">@drawable/kk_icon_circle</item>
        <item name="android:tint">@color/kk_primary</item>
        <item name="android:contentDescription">@null</item>
    </style>

    <style name="KK.MenuChevron">
        <item name="android:layout_width">24dp</item>
        <item name="android:layout_height">24dp</item>
        <item name="android:src">@drawable/ic_kk_right</item>
        <item name="android:tint">@color/kk_text_secondary</item>
        <item name="android:contentDescription">@null</item>
    </style>

</resources>
