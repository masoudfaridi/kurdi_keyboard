<Keyboard xmlns:android="http://schemas.android.com/apk/res/android"
    android:keyWidth="@fraction/samsung_key_width"
    android:horizontalGap="0px"
    android:verticalGap="0px"
    android:keyHeight="@fraction/samsung_key_height_letters"
    >


    <Row

        android:keyHeight="@fraction/samsung_key_height_numbers">
        <Key android:codes="0x2194" android:keyLabel="\u2194"
            android:verticalGap="@fraction/samsung_key_verticalGap"
            android:horizontalGap="@fraction/samsung_key_horizontalGap_left"
            android:keyEdgeFlags="left"/>
        <Key android:codes="0x2195" android:keyLabel="\u2195"
            />
        <Key android:codes="0x2196" android:keyLabel="\u2196"
            />
        <Key android:codes="0x2198" android:keyLabel="\u2198"
            />
        <Key android:codes="0x2197" android:keyLabel="\u2197"
            />
        <Key android:codes="0x2199" android:keyLabel="\u2199"
            />
        <Key android:codes="0x2190" android:keyLabel="\u2190"
            />
        <Key android:codes="0x2191" android:keyLabel="\u2191"
            />
        <Key android:codes="0x2193" android:keyLabel="\u2193"
            />
        <Key android:codes="0x2192" android:keyLabel="\u2192"
            android:keyEdgeFlags="right"/>
    </Row>

    <Row >
        <Key
            android:horizontalGap="@fraction/samsung_key_horizontalGap_left"
            android:codes="0x21AF" android:keyLabel="\u21AF"
            android:keyEdgeFlags="left"/>

        <Key android:codes="0x21B9" android:keyLabel="\u21B9"/>
        <Key android:codes="0x21BA" android:keyLabel="\u21BA"/>
        <Key android:codes="0x21BB" android:keyLabel="\u21BB"/>
        <Key android:codes="0x21C4" android:keyLabel="\u21C4"/>
        <Key android:codes="0x21C5" android:keyLabel="\u21C5"/>
        <Key android:codes="0x21C7" android:keyLabel="\u21C7"/>
        <Key android:codes="0x21C8" android:keyLabel="\u21C8"/>
        <Key android:codes="0x21CA" android:keyLabel="\u21CA"/>

        <Key android:codes="0x21C9" android:keyLabel="\u21C9"
            android:keyEdgeFlags="right"/>
    </Row>
    <Row >
        <Key
            android:horizontalGap="@fraction/samsung_key_horizontalGap_left"
            android:codes="0x21AD" android:keyLabel="\u21AD"
            android:keyEdgeFlags="left"/>

        <Key android:codes="0x21B9" android:keyLabel="\u21B9"/>
        <Key android:codes="0x21EB" android:keyLabel="\u21EB"/>
        <Key android:codes="0x21EA" android:keyLabel="\u21EA"/>
        <Key android:codes="0x21DC" android:keyLabel="\u21DC"/>
        <Key android:codes="0x21DD" android:keyLabel="\u21DD"/>
        <Key android:codes="0x21CD" android:keyLabel="\u21CD"/>
        <Key android:codes="0x21CE" android:keyLabel="\u21CE"/>
        <Key android:codes="0x21CF" android:keyLabel="\u21CF"/>

        <Key android:codes="0x0489" android:keyLabel="\u0489"
            android:keyEdgeFlags="right"/>
    </Row>

    <Row>
        <Key
            android:horizontalGap="@fraction/samsung_key_horizontalGap_left"
            android:codes="-117" android:keyLabel="6/13"
            android:popupKeyboard="@xml/popup_en_select_page_symbols"
            android:keyWidth="@fraction/samsung_key_width_shift" android:isModifier="true"
            android:keyEdgeFlags="left"/>

        <Key android:codes="0x21D5" android:keyLabel="\u21D5"/>
        <Key android:codes="0x21D4" android:keyLabel="\u21D4"/>
        <Key android:codes="0x21ED" android:keyLabel="\u21ED"/>
        <Key android:codes="0x21D0" android:keyLabel="\u21D0"/>
        <Key android:codes="0x21D1" android:keyLabel="\u21D1" />
        <Key android:codes="0x21D3" android:keyLabel="\u21D3" />
        <Key android:codes="0x21D2" android:keyLabel="\u21D2"/>
        <Key android:codes="-5" android:keyIcon="@drawable/delete_black"
            android:keyWidth="@fraction/samsung_key_width_shift" android:isModifier="true"
            android:keyEdgeFlags="right"
            android:isRepeatable="true"/>
    </Row>
    <Row android:rowEdgeFlags="bottom">
        <Key android:codes="-3"
            android:horizontalGap="@fraction/samsung_key_horizontalGap_left"
            android:keyIcon="@drawable/close_keyboard_black"
            android:keyWidth="@fraction/samsung_key_width_shift" android:keyEdgeFlags="left"/>
        <Key android:codes="-2" android:keyIcon="@drawable/abc_black"
            android:keyWidth="@fraction/samsung_key_width_shift"/>
        <!--
            android:codes: -101 is not a framework-defined key code but a key code that is
            privately defined in com.example.android.softkeyboard.LatinKeyboardView.
        -->

        <Key android:codes="32" android:keyIcon="@drawable/spacebar"

            android:keyWidth="@fraction/samsung_key_width_space" />
        <Key android:codes="46,44" android:keyIcon="@drawable/dot_black"
            android:popupKeyboard="@xml/popup_en_4_4"

            android:keyWidth="@fraction/samsung_key_width_shift"/>
        <Key android:codes="10" android:keyIcon="@drawable/enter_enter_black"
            android:popupKeyboard="@xml/popup_en_4_5"
            android:keyWidth="@fraction/samsung_key_width_shift" android:keyEdgeFlags="right"/>
    </Row>
    <Row android:horizontalGap="0%p" android:keyHeight="0%p">
        <Key android:codes="32"
            android:keyWidth="100%p"
            />
    </Row>
</Keyboard>