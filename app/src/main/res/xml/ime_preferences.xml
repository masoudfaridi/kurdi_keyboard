<?xml version="1.0" encoding="utf-8"?>
<!--
  Keyboard settings (2.x). Every key here is read by the keyboard; values live in the
  "MySharedPreference" file (ImePreferences sets that name).
-->
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:kurdikeyboard="http://kurdikeyboard.com"
    android:key="Setting"
    android:title="@string/settings_name">

    <!-- ============================== appearance -->
    <PreferenceScreen
        android:icon="@drawable/ic_kk_palette"
        android:key="settings_look"
        android:summary="@string/s_look_summary"
        android:title="@string/s_look_title">

        <PreferenceCategory android:title="@string/s_cat_theme">
            <Preference
                android:key="theme_picker"
                android:summary="@string/theme_picker_summary"
                android:title="@string/title_list_theme_selector">
                <intent
                    android:targetClass="com.kurdikeyboard.ThemePickerActivity"
                    android:targetPackage="com.kurdikeyboard" />
            </Preference>
            <com.kurdikeyboard.SeekBarPreference
                android:defaultValue="116"
                android:key="@string/prefseekbarfont"
                android:max="150"
                android:title="@string/s_font_size"
                kurdikeyboard:min="50" />
        </PreferenceCategory>

        <PreferenceCategory android:title="@string/s_cat_preview">
            <CheckBoxPreference
                android:defaultValue="true"
                android:key="@string/prefnotshowpreview"
                android:summary="@string/s_preview_summary"
                android:title="@string/s_preview_title" />
            <Preference
                android:dependency="@string/prefnotshowpreview"
                android:key="popup_style"
                android:summary="@string/popup_style_summary"
                android:title="@string/popup_style_title">
                <intent
                    android:targetClass="com.kurdikeyboard.PopupStyleActivity"
                    android:targetPackage="com.kurdikeyboard" />
            </Preference>
            <com.kurdikeyboard.SeekBarPreference
                android:defaultValue="24"
                android:dependency="@string/prefnotshowpreview"
                android:key="@string/prefpreviewgap"
                android:max="80"
                android:title="@string/title_preview_gap"
                kurdikeyboard:min="0" />
        </PreferenceCategory>

        <PreferenceCategory android:title="@string/s_cat_background">
            <CheckBoxPreference
                android:defaultValue="false"
                android:key="@string/prefimagefrbackground"
                android:summary="@string/s_bg_summary"
                android:title="@string/s_bg_title" />
            <Preference
                android:dependency="@string/prefimagefrbackground"
                android:key="pick_background"
                android:summary="@string/s_bg_pick_summary"
                android:title="@string/s_bg_pick_title">
                <intent
                    android:targetClass="com.kurdikeyboard.ImagePickerActivity"
                    android:targetPackage="com.kurdikeyboard" />
            </Preference>
            <com.kurdikeyboard.SeekBarPreference
                android:defaultValue="100"
                android:dependency="@string/prefimagefrbackground"
                android:key="@string/prefseekbaropacitykey"
                android:max="220"
                android:title="@string/s_bg_opacity"
                kurdikeyboard:min="40" />
        </PreferenceCategory>

        <PreferenceCategory android:title="@string/s_cat_toolbar">
            <CheckBoxPreference
                android:defaultValue="false"
                android:key="@string/preftoolbarsivkeyboard"
                android:summary="@string/s_hide_ready_summary"
                android:title="@string/s_hide_ready_title" />
            <CheckBoxPreference
                android:defaultValue="false"
                android:key="@string/preftoolbarsivkeyboardsetting"
                android:summary="@string/s_hide_gear_summary"
                android:title="@string/s_hide_gear_title" />
        </PreferenceCategory>
    </PreferenceScreen>

    <!-- ============================== prediction and swipe -->
    <PreferenceScreen
        android:icon="@drawable/ic_kk_sparkle"
        android:key="settingprediction"
        android:summary="@string/settings_prediction_summary"
        android:title="@string/settings_prediction_title">
        <PreferenceCategory android:title="@string/settings_prediction_title">
            <CheckBoxPreference
                android:defaultValue="true"
                android:key="@string/prefprediction"
                android:summary="@string/summary_prediction"
                android:title="@string/title_prediction" />
            <com.kurdikeyboard.SeekBarPreference
                android:defaultValue="4"
                android:dependency="@string/prefprediction"
                android:key="@string/prefsuggestcount"
                android:max="6"
                android:title="@string/title_suggest_count"
                kurdikeyboard:min="3" />
            <CheckBoxPreference
                android:defaultValue="true"
                android:key="@string/prefswipe"
                android:summary="@string/summary_swipe"
                android:title="@string/title_swipe" />
            <CheckBoxPreference
                android:defaultValue="true"
                android:key="@string/prefautospace"
                android:summary="@string/summary_autospace"
                android:title="@string/title_autospace" />
            <Preference
                android:selectable="false"
                android:summary="@string/summary_enter_hold" />
            <Preference
                android:key="@string/prefclearhistory"
                android:summary="@string/summary_clearhistory"
                android:title="@string/title_clearhistory" />
        </PreferenceCategory>
    </PreferenceScreen>

    <!-- ============================== space bar -->
    <PreferenceScreen
        android:icon="@drawable/ic_kk_keyboard"
        android:key="settingspace"
        android:summary="@string/settings_space_summary"
        android:title="@string/settings_space_title">
        <PreferenceCategory android:title="@string/settings_space_title">
            <CheckBoxPreference
                android:defaultValue="true"
                android:key="@string/prefspacecursor"
                android:summary="@string/summary_space_cursor"
                android:title="@string/title_space_cursor" />
            <com.kurdikeyboard.SeekBarPreference
                android:defaultValue="5"
                android:dependency="@string/prefspacecursor"
                android:key="@string/prefspacecursorspeed"
                android:max="10"
                android:title="@string/title_space_cursor_speed"
                kurdikeyboard:min="1" />
            <CheckBoxPreference
                android:defaultValue="true"
                android:key="@string/prefspacelang"
                android:summary="@string/summary_space_lang"
                android:title="@string/title_space_lang" />
            <com.kurdikeyboard.SeekBarPreference
                android:defaultValue="450"
                android:dependency="@string/prefspacelang"
                android:key="@string/prefspaceholdms"
                android:max="1000"
                android:title="@string/title_space_hold"
                kurdikeyboard:interval="50"
                kurdikeyboard:min="250" />
        </PreferenceCategory>
    </PreferenceScreen>

    <!-- ============================== languages -->
    <PreferenceScreen
        android:icon="@drawable/ic_kk_language"
        android:key="settings_languages"
        android:summary="@string/s_lang_summary"
        android:title="@string/s_lang_title">

        <PreferenceCategory android:title="@string/s_cat_languages">
            <CheckBoxPreference
                android:defaultValue="true"
                android:key="@string/preflanguage_farsi"
                android:summary="@string/s_lang_fa_summary"
                android:title="@string/lang_persian" />
            <CheckBoxPreference
                android:defaultValue="false"
                android:key="@string/preflanguage_kurdi"
                android:summary="@string/s_lang_ku_summary"
                android:title="@string/lang_kurdish" />
        </PreferenceCategory>

        <PreferenceCategory android:title="@string/s_cat_kurdish">
            <CheckBoxPreference
                android:defaultValue="false"
                android:dependency="@string/preflanguage_kurdi"
                android:key="@string/preflanguage_kurdi_extend"
                android:summary="@string/s_ku_extend_summary"
                android:title="@string/s_ku_extend_title" />
            <CheckBoxPreference
                android:defaultValue="false"
                android:dependency="@string/preflanguage_kurdi"
                android:key="@string/preflanguage_kurdi_vabouve"
                android:summary="@string/s_ku_join_summary"
                android:title="@string/s_ku_join_title" />
        </PreferenceCategory>

        <PreferenceCategory android:title="@string/s_cat_doubletap">
            <CheckBoxPreference
                android:defaultValue="true"
                android:key="@string/preflanguage_farsi_doublecick"
                android:summary="@string/s_dt_fa_summary"
                android:title="@string/s_dt_fa_title" />
            <CheckBoxPreference
                android:defaultValue="true"
                android:key="@string/preflanguage_kurdi_doublecick"
                android:summary="@string/s_dt_ku_summary"
                android:title="@string/s_dt_ku_title" />
            <com.kurdikeyboard.SeekBarPreference
                android:defaultValue="300"
                android:key="@string/prefseekbartimewordtwofuction"
                android:max="700"
                android:title="@string/s_dt_time"
                kurdikeyboard:interval="25"
                kurdikeyboard:min="150" />
        </PreferenceCategory>
    </PreferenceScreen>

    <!-- ============================== sound and vibration -->
    <PreferenceScreen
        android:icon="@drawable/ic_kk_volume"
        android:key="settings_feedback"
        android:summary="@string/s_feedback_summary"
        android:title="@string/s_feedback_title">
        <PreferenceCategory android:title="@string/s_feedback_title">
            <CheckBoxPreference
                android:defaultValue="true"
                android:key="@string/prefvibreh"
                android:summary="@string/s_vibrate_summary"
                android:title="@string/s_vibrate_title" />
            <CheckBoxPreference
                android:defaultValue="true"
                android:key="@string/prefsound"
                android:summary="@string/s_sound_summary"
                android:title="@string/s_sound_title" />
        </PreferenceCategory>
    </PreferenceScreen>

    <!-- ============================== text size in the keyboard's panels -->
    <PreferenceScreen
        android:icon="@drawable/ic_kk_text_size"
        android:key="settings_panel_text"
        android:summary="@string/s_panels_summary"
        android:title="@string/s_panels_title">
        <PreferenceCategory android:title="@string/s_panels_title">
            <com.kurdikeyboard.SeekBarPreference
                android:defaultValue="72"
                android:key="@string/prefseekbarfontclipbooard"
                android:max="100"
                android:title="@string/s_panel_clipboard"
                kurdikeyboard:min="40" />
            <com.kurdikeyboard.SeekBarPreference
                android:defaultValue="72"
                android:key="@string/prefseekbarfontreadysentences"
                android:max="100"
                android:title="@string/s_panel_ready"
                kurdikeyboard:min="40" />
        </PreferenceCategory>
    </PreferenceScreen>

    <!-- ============================== help and about -->
    <PreferenceCategory android:title="@string/s_cat_about">
        <Preference
            android:icon="@drawable/ic_kk_help"
            android:key="pref_guide"
            android:summary="@string/s_guide_summary"
            android:title="@string/textbuttonguid">
            <intent
                android:targetClass="com.kurdikeyboard.MainActivityViewPager"
                android:targetPackage="com.kurdikeyboard" />
        </Preference>
        <Preference
            android:icon="@drawable/ic_kk_star"
            android:key="@string/pref_forceupdate"
            android:summary="@string/unknown"
            android:title="@string/textUpdate">
            <intent
                android:targetClass="com.kurdikeyboard.UpdatePage"
                android:targetPackage="com.kurdikeyboard" />
        </Preference>
        <Preference
            android:icon="@drawable/ic_kk_info"
            android:key="@string/pref_version"
            android:selectable="false"
            android:summary="@string/s_about_summary"
            android:title="@string/s_about_title" />
    </PreferenceCategory>
</PreferenceScreen>
