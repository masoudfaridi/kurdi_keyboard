            <CheckBoxPreference
                android:key="@string/prefautospace"
                android:title="@string/title_autospace"
                android:summary="@string/summary_autospace"
                android:defaultValue="true" />
            <Preference
                android:selectable="false"
                android:summary="@string/summary_enter_hold" />
            <Preference
                android:key="@string/prefclearhistory"
                android:title="@string/title_clearhistory"
                android:summary="@string/summary_clearhistory" />
        </PreferenceCategory>
    </PreferenceScreen>




