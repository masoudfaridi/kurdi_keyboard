<Keyboard xmlns:android="http://schemas.android.com/apk/res/android"
    android:keyWidth="@fraction/samsung_key_width"
    android:horizontalGap="0px"
    android:verticalGap="0px"
    android:keyHeight="@fraction/samsung_key_height_letters"
    >

    <Row android:keyHeight="@fraction/samsung_key_height_numbers">
        <Key
            android:verticalGap="@fraction/samsung_key_verticalGap"
            android:horizontalGap="@fraction/samsung_key_horizontalGap_left"
            android:codes="0x0661" android:keyLabel="\u0661"
            android:popupKeyboard="@xml/popup_symbols_en_1_1_1" android:keyEdgeFlags="left"/>
        <Key android:codes="0x0662" android:keyLabel="\u0662"
            android:popupKeyboard="@xml/popup_symbols_en_1_1_2"/>
        <Key android:codes="0x0663" android:keyLabel="\u0663"
            android:popupKeyboard="@xml/popup_symbols_en_1_1_3"/>
        <Key android:codes="0x0664" android:keyLabel="\u0664"
            android:popupKeyboard="@xml/popup_symbols_en_1_1_4"/>
        <Key android:codes="0x0665" android:keyLabel="\u0665"
            android:popupKeyboard="@xml/popup_symbols_en_1_1_5"/>
        <Key android:codes="0x0666" android:keyLabel="\u0666"
            android:popupKeyboard="@xml/popup_symbols_en_1_1_6"/>
        <Key android:codes="0x0667" android:keyLabel="\u0667"
            android:popupKeyboard="@xml/popup_symbols_en_1_1_7"/>
        <Key android:codes="0x0668" android:keyLabel="\u0668"
            android:popupKeyboard="@xml/popup_symbols_en_1_1_8"/>
        <Key android:codes="0x0669" android:keyLabel="\u0669"
            android:popupKeyboard="@xml/popup_symbols_en_1_1_9"/>
        <Key android:codes="0x0660" android:keyLabel="\u0660"
            android:popupKeyboard="@xml/popup_symbols_en_1_1_0" android:keyEdgeFlags="right"/>
    </Row>

    <Row>
        <Key android:codes="0x0060" android:keyLabel="\u0060"
            android:horizontalGap="@fraction/samsung_key_horizontalGap_left"
            android:keyEdgeFlags="left"/>
        <Key android:codes="0x00B4" android:keyLabel="\u00B4"/>

        <Key android:codes="0x007E" android:keyLabel="\u007E"/>
        <Key android:codes="0x25AA" android:keyLabel="\u25AA"/>
        <Key android:codes="0x003C" android:keyLabel="\u003C"/>
        <Key android:codes="0x003E" android:keyLabel="\u003E"/>
        <Key android:codes="123" android:keyLabel="{"/>
        <Key android:codes="125" android:keyLabel="}" />
        <Key android:codes="91" android:keyLabel="["/>
        <Key android:codes="93" android:keyLabel="]" android:keyEdgeFlags="right"/>

    </Row>

    <Row>
        <Key android:codes="0x00B0" android:keyLabel="\u00B0"
            android:horizontalGap="@fraction/samsung_key_horizontalGap_left"

            android:keyEdgeFlags="left"/>


        <Key android:codes="0x2022" android:keyLabel="\u2022"/>
        <Key android:codes="0x25CB" android:keyLabel="\u25CB"/>
        <Key android:codes="0x25CF" android:keyLabel="\u25CF"/>
        <Key android:codes="0x25A1" android:keyLabel="\u25A1"/>
        <Key android:codes="0x25A0" android:keyLabel="\u25A0"/>
        <Key android:codes="0x2664" android:keyLabel="\u2664"/>
        <Key android:codes="0x2661" android:keyLabel="\u2661"/>
        <Key android:codes="0x2662" android:keyLabel="\u2662"/>

        <Key android:codes="0x2667" android:keyLabel="\u2667" android:keyEdgeFlags="right"/>

    </Row>


    <Row>
        <Key android:codes="-117" android:keyLabel="2/13"
            android:horizontalGap="@fraction/samsung_key_horizontalGap_left"
            android:popupKeyboard="@xml/popup_en_select_page_symbols"

            android:keyWidth="@fraction/samsung_key_width_shift" android:isModifier="true"

            android:keyEdgeFlags="left"/>

        <Key android:codes="0x2606" android:keyLabel="\u2606"
            android:popupKeyboard="@xml/popup_symbols_en_2_4_2"/>


        <Key android:codes="0x300A" android:keyLabel="\u300A"/>

        <Key android:codes="0x300B" android:keyLabel="\u300B"/>

        <Key android:codes="124" android:keyLabel="|"/>
        <Key android:codes="92" android:keyLabel="\\" />
        <Key android:codes="161" android:keyLabel="¡" />
        <Key android:codes="191" android:keyLabel="¿"/>
        <Key android:codes="-5" android:keyIcon="@drawable/delete_black"
            android:keyWidth="@fraction/samsung_key_width_shift" android:isModifier="true"
            android:keyEdgeFlags="right"
            android:isRepeatable="true"/>
    </Row>

    <Row android:rowEdgeFlags="bottom">
        <Key android:codes="-3"
            android:horizontalGap="@fraction/samsung_key_horizontalGap_left"
            android:keyIcon="@drawable/close_keyboard_black"
            android:keyWidth="@fraction/samsung_key_width_shift" android:keyEdgeFlags="left"/>
        <Key android:codes="-2" android:keyIcon="@drawable/abc_black"
            android:keyWidth="@fraction/samsung_key_width_shift"/>
        <!--
            android:codes: -101 is not a framework-defined key code but a key code that is
            privately defined in com.example.android.softkeyboard.LatinKeyboardView.
        -->

        <Key android:codes="32" android:keyIcon="@drawable/spacebar"

            android:keyWidth="@fraction/samsung_key_width_space" />
        <Key android:codes="46,44" android:keyIcon="@drawable/dot_black"
            android:popupKeyboard="@xml/popup_en_4_4"

            android:keyWidth="@fraction/samsung_key_width_shift"/>
        <Key android:codes="10" android:keyIcon="@drawable/enter_enter_black"
            android:popupKeyboard="@xml/popup_en_4_5"
            android:keyWidth="@fraction/samsung_key_width_shift" android:keyEdgeFlags="right"/>
    </Row>
    <Row android:horizontalGap="0%p" android:keyHeight="0%p">
        <Key android:codes="32"
            android:keyWidth="100%p"
            />
    </Row>
</Keyboard>