<Keyboard
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:keyWidth="12%p"
    android:keyHeight="@dimen/key_height_popup_en_e_multilanguage"
    android:horizontalGap="0px"
    android:verticalGap="0px"
    >


    <Row>
        <Key android:codes="64" android:keyLabel="\@"
            android:keyEdgeFlags="left"/>


        <Key android:codes="60" android:keyLabel="\u003C"/>
        <Key android:codes="62" android:keyLabel="\u003E"/>
        <Key android:codes="40" android:keyLabel="("/>
        <Key android:codes="41" android:keyLabel=")"/>

        <Key android:codes="39" android:keyLabel="\u0027"/>

        <Key android:codes="34" android:keyLabel="&quot;"
            android:keyEdgeFlags="right"/>
    </Row>



    <Row>
        <!-- -190: the 5 symbols typed last, the newest on the right (KKeyboardView
             fillRecentSymbols). The labels are shown until enough symbols were typed.
             Paste, copy, clipboard, emoji and ready sentences are in the tools row and on the
             emoji key. -->
        <Key android:codes="-190" android:keyLabel="*"
            android:keyEdgeFlags="left"/>
        <Key android:codes="-190" android:keyLabel="»"/>
        <Key android:codes="-190" android:keyLabel="«"/>
        <Key android:codes="-190" android:keyLabel="؛"/>
        <Key android:codes="-190" android:keyLabel=":"/>
        <Key android:codes="45" android:keyLabel="-"/>


        <Key android:codes="43" android:keyLabel="+"
            android:keyEdgeFlags="right"/>

    </Row>

    <Row>

        <Key android:codes="124" android:keyLabel="|"/>
        <Key android:codes="92" android:keyLabel="\\" />
        <Key android:codes="47" android:keyLabel="/" />

        <Key android:codes="1548" android:keyLabel="\u060C"/>
        <Key android:codes="46" android:keyLabel="."/>
        <Key android:codes="33" android:keyLabel="!" />
        <Key android:codes="1567" android:keyLabel="\u061F"
            android:keyEdgeFlags="right"/>

    </Row>











</Keyboard>