<Keyboard xmlns:android="http://schemas.android.com/apk/res/android"
    android:keyWidth="@fraction/samsung_key_width"
    android:horizontalGap="0px"
    android:verticalGap="0px"
    android:keyHeight="@fraction/samsung_key_height_letters"
    >

    <Row

        android:keyHeight="@fraction/samsung_key_height_numbers">
        <Key android:codes="0x279F" android:keyLabel="\u279F"
            android:verticalGap="@fraction/samsung_key_verticalGap"
            android:horizontalGap="@fraction/samsung_key_horizontalGap_left"
            android:keyEdgeFlags="left"/>
        <Key android:codes="0x27A0" android:keyLabel="\u27A0"
            />
        <Key android:codes="0x27A4" android:keyLabel="\u27A4"
            />
        <Key android:codes="0x27A9" android:keyLabel="\u27A9"
            />
        <Key android:codes="0x27AB" android:keyLabel="\u27AB"
            />
        <Key android:codes="0x27BE" android:keyLabel="\u27BE"
            />
        <Key android:codes="0x27BD" android:keyLabel="\u27BD"
            />
        <Key android:codes="0x27BC" android:keyLabel="\u27BC"
            />
        <Key android:codes="0x27BB" android:keyLabel="\u27BB"
            />
        <Key android:codes="0x27BA" android:keyLabel="\u27BA"
            android:keyEdgeFlags="right"/>
    </Row>

    <Row >
        <Key
            android:horizontalGap="@fraction/samsung_key_horizontalGap_left"
            android:codes="0x27B9" android:keyLabel="\u27B9"
            android:keyEdgeFlags="left"/>

        <Key android:codes="0x27B8" android:keyLabel="\u27B8"/>
        <Key android:codes="0x27B7" android:keyLabel="\u27B7"/>
        <Key android:codes="0x27B6" android:keyLabel="\u27B6"/>
        <Key android:codes="0x27B5" android:keyLabel="\u27B5"/>
        <Key android:codes="0x27B4" android:keyLabel="\u27B4"/>
        <Key android:codes="0x27B3" android:keyLabel="\u27B3"/>
        <Key android:codes="0x27B1" android:keyLabel="\u27B1"/>
        <Key android:codes="0x27AC" android:keyLabel="\u27AC"/>

        <Key android:codes="0x2044" android:keyLabel="\u2044"
            android:keyEdgeFlags="right"/>
    </Row>
    <Row >
        <Key
            android:horizontalGap="@fraction/samsung_key_horizontalGap_left"
            android:codes="0x00BD" android:keyLabel="\u00BD"
            android:keyEdgeFlags="left"/>

        <Key android:codes="0x2153" android:keyLabel="\u2153"/>
        <Key android:codes="0x2154" android:keyLabel="\u2154"/>
        <Key android:codes="0x00BC" android:keyLabel="\u00BC"/>
        <Key android:codes="0x00BE" android:keyLabel="\u00BE"/>
        <Key android:codes="0x2155" android:keyLabel="\u2155"/>
        <Key android:codes="0x2156" android:keyLabel="\u2156"/>
        <Key android:codes="0x2157" android:keyLabel="\u2157"/>
        <Key android:codes="0x2158" android:keyLabel="\u2158"/>

        <Key android:codes="0x215F" android:keyLabel="\u215F"
            android:keyEdgeFlags="right"/>
    </Row>

    <Row>
        <Key
            android:horizontalGap="@fraction/samsung_key_horizontalGap_left"
            android:popupKeyboard="@xml/popup_en_select_page_symbols"
            android:codes="-117" android:keyLabel="7/13"
            android:keyWidth="@fraction/samsung_key_width_shift" android:isModifier="true"
            android:keyEdgeFlags="left"/>

        <Key android:codes="0x2159" android:keyLabel="\u2159"/>
        <Key android:codes="0x215A" android:keyLabel="\u215A"/>
        <Key android:codes="0x215B" android:keyLabel="\u215B"/>
        <Key android:codes="0x215C" android:keyLabel="\u215C"/>
        <Key android:codes="0x215D" android:keyLabel="\u215D" />
        <Key android:codes="0x215E" android:keyLabel="\u215E" />
        <Key android:codes="0x2139" android:keyLabel="\u2139"/>
        <Key android:codes="-5" android:keyIcon="@drawable/delete_black"
            android:keyWidth="@fraction/samsung_key_width_shift" android:isModifier="true"
            android:keyEdgeFlags="right"
            android:isRepeatable="true"/>
    </Row>
    <Row android:rowEdgeFlags="bottom">
        <Key android:codes="-3"
            android:horizontalGap="@fraction/samsung_key_horizontalGap_left"
            android:keyIcon="@drawable/close_keyboard_black"
            android:keyWidth="@fraction/samsung_key_width_shift" android:keyEdgeFlags="left"/>
        <Key android:codes="-2" android:keyIcon="@drawable/abc_black"
            android:keyWidth="@fraction/samsung_key_width_shift"/>
        <!--
            android:codes: -101 is not a framework-defined key code but a key code that is
            privately defined in com.example.android.softkeyboard.LatinKeyboardView.
        -->

        <Key android:codes="32" android:keyIcon="@drawable/spacebar"

            android:keyWidth="@fraction/samsung_key_width_space" />
        <Key android:codes="46,44" android:keyIcon="@drawable/dot_black"
            android:popupKeyboard="@xml/popup_en_4_4"

            android:keyWidth="@fraction/samsung_key_width_shift"/>
        <Key android:codes="10" android:keyIcon="@drawable/enter_enter_black"
            android:popupKeyboard="@xml/popup_en_4_5"
            android:keyWidth="@fraction/samsung_key_width_shift" android:keyEdgeFlags="right"/>
    </Row>
    <Row android:horizontalGap="0%p" android:keyHeight="0%p">
        <Key android:codes="32"
            android:keyWidth="100%p"
            />
    </Row>
</Keyboard>