<Keyboard xmlns:android="http://schemas.android.com/apk/res/android"
    android:keyWidth="@fraction/samsung_key_width"
    android:horizontalGap="0px"
    android:verticalGap="0px"
    android:keyHeight="@fraction/samsung_key_height_letters"
    >

    <Row android:keyHeight="@fraction/samsung_key_height_numbers">
        <Key android:codes="0x0661" android:keyLabel="\u0661"
            android:horizontalGap="@fraction/samsung_key_horizontalGap_left"
            android:popupKeyboard="@xml/popup_symbols_en_1_1_1" android:keyEdgeFlags="left"/>
        <Key android:codes="0x0662" android:keyLabel="\u0662"
            android:popupKeyboard="@xml/popup_symbols_en_1_1_2"/>
        <Key android:codes="0x0663" android:keyLabel="\u0663"
            android:popupKeyboard="@xml/popup_symbols_en_1_1_3"/>
        <Key android:codes="0x0664" android:keyLabel="\u0664"
            android:popupKeyboard="@xml/popup_symbols_en_1_1_4"/>
        <Key android:codes="0x0665" android:keyLabel="\u0665"
            android:popupKeyboard="@xml/popup_symbols_en_1_1_5"/>
        <Key android:codes="0x0666" android:keyLabel="\u0666"
            android:popupKeyboard="@xml/popup_symbols_en_1_1_6"/>
        <Key android:codes="0x0667" android:keyLabel="\u0667"
            android:popupKeyboard="@xml/popup_symbols_en_1_1_7"/>
        <Key android:codes="0x0668" android:keyLabel="\u0668"
            android:popupKeyboard="@xml/popup_symbols_en_1_1_8"/>
        <Key android:codes="0x0669" android:keyLabel="\u0669"
            android:popupKeyboard="@xml/popup_symbols_en_1_1_9"/>
        <Key android:codes="0x0660" android:keyLabel="\u0660"
            android:popupKeyboard="@xml/popup_symbols_en_1_1_0" android:keyEdgeFlags="right"/>
    </Row>


    <Row>
        <Key android:codes="1589,1590" android:keyLabel="ص"
            android:horizontalGap="@fraction/samsung_key_horizontalGap_left"
            android:popupKeyboard="@xml/popup_fa_1_1"
            android:keyEdgeFlags="left"/>
        <Key android:codes="0x062B" android:keyLabel="ث"
            android:popupKeyboard="@xml/popup_fa_1_2"/>
        <Key android:codes="0x0642" android:keyLabel="ق"
            android:popupKeyboard="@xml/popup_fa_1_3"
            />
        <Key android:codes="0x0641" android:keyLabel="ف"
            android:popupKeyboard="@xml/popup_fa_1_4"  />
        <Key android:codes="1593,1594"
            android:popupKeyboard="@xml/popup_fa_1_5"
            android:keyLabel="\u0639"/>
        <Key android:codes="0x0647"
            android:popupKeyboard="@xml/popup_fa_1_6"
            android:keyLabel="ه"/>
        <Key android:codes="0x062E"
            android:popupKeyboard="@xml/popup_fa_1_7"
            android:keyLabel="خ"/>
        <Key android:codes="0x062D"
            android:popupKeyboard="@xml/popup_fa_1_8"
            android:keyLabel="ح" />
        <Key android:codes="0x062C"
            android:popupKeyboard="@xml/popup_fa_1_9"
            android:keyLabel="ج"/>
        <Key android:codes="0x0686"
            android:popupKeyboard="@xml/popup_fa_1_10"

            android:keyLabel="چ" android:keyEdgeFlags="right"/>
    </Row>

    <Row>
        <Key android:codes="0x0634" android:keyLabel="ش"
            android:popupKeyboard="@xml/popup_fa_2_1"
            android:horizontalGap="@fraction/samsung_key_horizontalGap_left"
            android:keyEdgeFlags="left"/>
        <Key android:codes="0x0633"
            android:popupKeyboard="@xml/popup_fa_2_2"
            android:keyLabel="س"/>
        <Key android:codes="1740"
            android:popupKeyboard="@xml/popup_fa_2_3"
            android:keyLabel="ی"/>
        <Key android:codes="0x0628" android:keyLabel="ب"
            android:popupKeyboard="@xml/popup_fa_2_4"
            />
        <Key android:codes="0x0644"
            android:popupKeyboard="@xml/popup_fa_2_5"

            android:keyLabel="ل"/>
        <Key android:codes="1575,1570"
            android:popupKeyboard="@xml/popup_fa_2_6"
            android:keyLabel="ا"/>
        <Key android:codes="0x062A"
            android:popupKeyboard="@xml/popup_fa_2_7"

            android:keyLabel="ت"/>
        <Key android:codes="0x0646"
            android:popupKeyboard="@xml/popup_fa_2_8"

            android:keyLabel="ن"/>
        <Key android:codes="0x0645"
            android:popupKeyboard="@xml/popup_fa_2_9"
            android:keyLabel="م"/>
        <Key android:codes="0x067E"
            android:popupKeyboard="@xml/popup_fa_2_10"
            android:keyLabel="پ" android:keyEdgeFlags="right"/>
    </Row>

    <Row>

        <Key android:codes="8204,-120" android:keyIcon="@drawable/half_space_black"
            android:horizontalGap="@fraction/samsung_key_horizontalGap_left"
            android:keyWidth="@fraction/samsung_key_width_shift"

            android:popupKeyboard="@xml/popup_fa_line"
            android:keyEdgeFlags="left"/>
        <Key android:codes="1591,1592"
            android:popupKeyboard="@xml/popup_fa_3_1"
            android:keyLabel="ط"/>
        <Key android:codes="1586,1688"
            android:popupKeyboard="@xml/popup_fa_3_2"
            android:keyLabel="ز"/>
        <Key android:codes="0x0631"
            android:popupKeyboard="@xml/popup_fa_3_3"
            android:keyLabel="ر"/>
        <Key android:codes="1583,1584"
            android:popupKeyboard="@xml/popup_fa_3_4"
            android:keyLabel="دف"/>
        <Key android:codes="1608,1572"
            android:popupKeyboard="@xml/popup_fa_3_5"
            android:keyLabel="و"/>
        <Key android:codes="1705,1574"   android:keyLabel="ک"
            android:popupKeyboard="@xml/popup_fa_3_6"
            />


        <!-- android:popupKeyboard="@xml/popup_fa_3_7" -->
        <Key android:codes="1711,1569"
            android:keyLabel="گ"/>
        <Key android:codes="-5" android:keyIcon="@drawable/delete_black"
            android:isRepeatable="true"
            android:keyWidth="@fraction/samsung_key_width_shift"
            android:keyEdgeFlags="right"/>
    </Row>

    <Row android:rowEdgeFlags="bottom">
        <Key android:codes="-3"
            android:horizontalGap="@fraction/samsung_key_horizontalGap_left"
            android:keyIcon="@drawable/close_keyboard_black"
            android:keyWidth="@fraction/samsung_key_width_shift" android:keyEdgeFlags="left"/>
        <Key android:codes="-2" android:keyIcon="@drawable/numbers_black"
            android:keyWidth="@fraction/samsung_key_width_shift"/>
        <!--
            android:codes: -101 is not a framework-defined key code but a key code that is
            privately defined in com.example.android.softkeyboard.LatinKeyboardView.
        -->

        <Key android:codes="32" android:keyIcon="@drawable/spacebarfa"

            android:keyWidth="@fraction/samsung_key_width_space" />
        <Key android:codes="-158" android:keyIcon="@drawable/dot_black_en"
            android:popupKeyboard="@xml/popup_multikey_fa"

            android:keyWidth="@fraction/samsung_key_width_shift"/>
        <Key android:codes="10" android:keyIcon="@drawable/enter_enter_black"
            android:popupKeyboard="@xml/popupkeyboardfarsiaarab"
            android:keyWidth="@fraction/samsung_key_width_shift" android:keyEdgeFlags="right"/>
    </Row>
    <Row android:horizontalGap="0%p" android:keyHeight="0.01%p">
        <Key android:codes="32" android:keyLabel=""
            android:keyWidth="100%p"
            />

    </Row>







</Keyboard>

