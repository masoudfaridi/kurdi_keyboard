<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list xmlns:android="http://schemas.android.com/apk/res/android">

            <item
                android:left="@dimen/simplethemepaddingaroundkey"
                android:right="@dimen/simplethemepaddingaroundkey"
                android:top="@dimen/simplethemepaddingaroundkey"
                android:bottom="@dimen/simplethemepaddingaroundkey"
                >
                <shape android:shape="rectangle">

                    <gradient
                        android:startColor="#ffa5cf"
                        android:endColor="#ff9ac9"
                        android:centerColor="#f771b0"
                        android:angle="180"
                        />



                    <corners android:radius="3dp"/>


                </shape>

            </item>

        </layer-list>
    </item>
    <item >
        <layer-list xmlns:android="http://schemas.android.com/apk/res/android">


            <item
                android:left="@dimen/simplethemepaddingaroundkey"
                android:right="@dimen/simplethemepaddingaroundkey"
                android:top="@dimen/simplethemepaddingaroundkey"
                android:bottom="@dimen/simplethemepaddingaroundkey"
                >
                <shape android:shape="rectangle">

                    <corners android:radius="4dp"/>
                    <solid android:color="#ffdfe8"/>
                    <stroke android:width="1.5dp" android:color="#a5ddb5"/>




                </shape>
            </item>












        </layer-list>
    </item>
</selector>