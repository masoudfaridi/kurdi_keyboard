<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list xmlns:android="http://schemas.android.com/apk/res/android">

            <item
                android:left="@dimen/simplethemepaddingaroundkey"
                android:right="@dimen/simplethemepaddingaroundkey"
                android:top="@dimen/simplethemepaddingaroundkey"
                android:bottom="@dimen/simplethemepaddingaroundkey"
                >
                <shape android:shape="rectangle">

                    <gradient
                        android:startColor="#002a49"
                        android:endColor="#0c3d66"
                        android:centerColor="#00416f"
                        android:angle="180"
                        />



                    <corners android:radius="3dp"/>


                </shape>

            </item>

        </layer-list>
    </item>
    <item >
        <layer-list xmlns:android="http://schemas.android.com/apk/res/android">

            <item
                android:left="4dp"
                android:right="4dp"
                android:top="4dp"
                android:bottom="4dp"
                >
                <shape
                    android:shape="rectangle" >

                    <solid
                        android:color="#000060a7"/>
                    <stroke android:width=".5dp" android:color="#ffffff"/>
                    <corners android:radius="4dp"/>


                </shape>
            </item>













        </layer-list>
    </item>
</selector>