<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/kk_card_item"
    android:gravity="center_vertical"
    android:layoutDirection="rtl"
    android:minHeight="60dp"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingTop="8dp"
    android:paddingEnd="6dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/clipboarddate2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:textAlignment="viewStart"
            android:textColor="@color/kk_text"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/clipboardstring2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:maxLines="2"
            android:ellipsize="end"
            android:textAlignment="viewStart"
            android:textColor="@color/kk_text_secondary"
            android:textSize="13sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/clipboarddelete2"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/kk_icon_button"
        android:contentDescription="delete"
        android:padding="11dp"
        android:src="@drawable/ic_kk_delete"
        android:tint="@color/kk_text_secondary" />
</LinearLayout>
