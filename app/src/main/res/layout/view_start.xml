<?xml version="1.0" encoding="utf-8"?>

<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical" android:layout_width="match_parent"
    android:layout_height="match_parent"
    >



    <WebView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/vebviewguidpage1_1"
        />
    <WebView
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:id="@+id/vebviewguidpage1_2"
        android:layout_below="@+id/vebviewguidpage1_1"
        android:layout_alignParentLeft="true"
        android:layout_alignParentStart="true"
        android:layout_above="@+id/imageButton" />

    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/imageButton"
        android:visibility="gone"
        android:layout_above="@+id/textView4"
        android:src="@drawable/nextpreviosviewpager"
        android:layout_alignRight="@+id/textView4"
        android:layout_alignEnd="@+id/textView4"
        android:scaleType="fitXY"
        android:layout_alignLeft="@+id/textView4"
        android:layout_alignStart="@+id/textView4"
        android:background="#ffffff"
        android:minHeight="220dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/viewpagernextpreviospage"
        android:id="@+id/textView4"
        android:visibility="gone"
        android:layout_above="@+id/textView3"
        android:layout_centerHorizontal="true" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/SwipeRightToNextView"
        android:layout_gravity="center_horizontal"
        android:textSize="14sp"
        android:textColor="@android:color/black"
        android:textStyle="bold"
        android:minLines="2"
        android:id="@+id/textView3"
        android:padding="@dimen/activity_horizontal_margin"
        android:layout_alignParentBottom="true"
        android:layout_alignParentRight="true"
        android:layout_alignParentEnd="true"
        android:visibility="invisible" />

</RelativeLayout>
