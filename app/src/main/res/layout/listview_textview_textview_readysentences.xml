<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:orientation="horizontal"
    android:weightSum="1"
    android:gravity="center_horizontal">

    <ImageView
        android:src="@drawable/enter_send_white"
        android:layout_width="0dp"
        android:id="@+id/imageviewsendreadysentences"
        android:layout_weight=".1"
        android:layout_height="50dp" />
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="fill_parent"
        android:orientation="vertical"
        android:layout_weight="0.60">
        <TextView
            android:id="@+id/clipboarddate2"
            android:layout_marginLeft="30dp"
            android:layout_marginRight="30dp"
            android:layout_width="wrap_content"
            android:layout_height="25dp"
            android:paddingTop="5dp"/>

        <TextView
            android:id="@+id/clipboardstring2"
            android:layout_marginLeft="30dp"
            android:layout_marginRight="30dp"
            android:layout_width="wrap_content"
            android:layout_height="25dp"
            android:paddingTop="5dp"/>
    </LinearLayout>
    <ImageView
        android:src="@drawable/recyclebin_png"
        android:layout_width="50dp"
        android:id="@+id/clipboarddelete2"
        android:layout_weight=".1"
        android:layout_height="50dp" />
</LinearLayout>