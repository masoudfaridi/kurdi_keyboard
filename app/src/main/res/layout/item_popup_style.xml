<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/kk_theme_card"
    android:orientation="vertical"
    android:padding="8dp">

    <view
        android:id="@+id/stylePreview"
        class="com.kurdikeyboard.PopupStyleActivity$StylePreview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/styleName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:textColor="@color/kk_text"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/styleDesc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center"
        android:minLines="2"
        android:textColor="@color/kk_text_secondary"
        android:textSize="12sp" />
</LinearLayout>
