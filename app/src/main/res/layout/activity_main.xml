<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/kk_bg"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    android:layoutDirection="rtl">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="20dp"
        android:paddingEnd="16dp"
        android:paddingBottom="24dp"
        tools:context="com.kurdikeyboard.MainActivity">

        <!-- header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_launcher" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="@color/kk_text"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/home_subtitle"
                    style="@style/KK.Caption" />
            </LinearLayout>
        </LinearLayout>

        <!-- setup: two steps with live status -->
        <LinearLayout
            android:id="@+id/setupCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/card_background"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/setup_title"
                style="@style/KK.Title" />

            <TextView
                android:id="@+id/stepEnable"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/step_background"
                android:gravity="center_vertical|start"
                android:minHeight="52dp"
                android:onClick="onClick"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="@color/kk_text"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/stepSelect"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/step_background"
                android:gravity="center_vertical|start"
                android:minHeight="52dp"
                android:onClick="onClick"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="@color/kk_text"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- try it -->
        <EditText
            android:id="@+id/tryField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/card_background"
            android:gravity="top|start"
            android:hint="@string/try_hint"
            android:inputType="textMultiLine|textCapSentences"
            android:minLines="3"
            android:padding="16dp"
            android:textColor="@color/kk_text"
            android:textColorHint="@color/kk_text_secondary"
            android:textSize="17sp" />

        <!-- menu -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/card_background"
            android:orientation="vertical"
            android:padding="8dp">

            <LinearLayout
                android:id="@+id/buttonactivationIME"
                style="@style/KK.MenuRow"
                android:onClick="onClick">

                <ImageView
                    style="@style/KK.MenuIcon"
                    android:src="@drawable/ic_kk_settings" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/KK.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/open_settings" />

                    <TextView
                        style="@style/KK.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/home_settings_summary" />
                </LinearLayout>

                <ImageView
                    style="@style/KK.MenuChevron" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="64dp"
                android:background="@color/kk_stroke" />

            <LinearLayout
                android:id="@+id/buttonGuid"
                style="@style/KK.MenuRow"
                android:onClick="onClick">

                <ImageView
                    style="@style/KK.MenuIcon"
                    android:src="@drawable/ic_kk_help" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/KK.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/textbuttonguid" />

                    <TextView
                        style="@style/KK.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/home_guide_summary" />
                </LinearLayout>

                <ImageView
                    style="@style/KK.MenuChevron" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
