<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"

    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/layouttools"
        android:visibility="visible"
        android:background="@drawable/a_23_mf_theme_23_background_keyboard"
        android:orientation="horizontal"
        >

        <ImageView

            android:id="@+id/ivKeyboard"
            android:layout_width="0dp"
            android:layout_weight="0.12"
            android:scaleType="center"
            android:layout_height="@dimen/key_height_firstrow"

            android:padding="@dimen/padding_firstrow"

            android:src="@drawable/ic_emoji_people_light_activated" />

        <ImageView
            android:id="@+id/ivKeyboardselectall"
            android:layout_width="0dp"
            android:layout_weight="0.12"
            android:scaleType="center"
            android:layout_height="@dimen/key_height_firstrow"
            android:padding="@dimen/padding_firstrow"

            android:src="@drawable/ic_menu_selectall_holo_dark"
            />


        <ImageView
            android:id="@+id/ivKeyboardcopy"
            android:layout_width="0dp"
            android:layout_weight="0.12"
            android:scaleType="center"
            android:layout_height="@dimen/key_height_firstrow"
            android:padding="@dimen/padding_firstrow"

            android:src="@drawable/ic_menu_copy_holo_dark"
            />

        <ImageView
            android:id="@+id/ivKeyboardback"
            android:layout_width="0dp"
            android:layout_weight="0.12"
            android:scaleType="center"
            android:layout_height="@dimen/key_height_firstrow"
            android:padding="@dimen/padding_firstrow"

            android:src="@drawable/ic_menu_back"
            />

        <ImageView
            android:id="@+id/ivKeyboardforward"
            android:layout_width="0dp"
            android:layout_weight="0.12"
            android:scaleType="center"
            android:layout_height="@dimen/key_height_firstrow"
            android:padding="@dimen/padding_firstrow"

            android:src="@drawable/ic_menu_forward"
            />

        <ImageView
            android:id="@+id/ivKeyboardcut"
            android:layout_width="0dp"
            android:layout_weight="0.12"
            android:scaleType="center"
            android:layout_height="@dimen/key_height_firstrow"
            android:padding="@dimen/padding_firstrow"

            android:src="@drawable/ic_menu_cut_holo_dark"
            />

        <ImageView
            android:id="@+id/ivKeyboardpaste"
            android:layout_width="0dp"
            android:layout_weight="0.12"
            android:scaleType="center"
            android:layout_height="@dimen/key_height_firstrow"

            android:padding="@dimen/padding_firstrow"

            android:src="@drawable/ic_menu_paste_holo_dark"
            />

        <ImageView
            android:id="@+id/ivKeyboardsetting"
            android:layout_width="0dp"
            android:layout_weight="0.12"
            android:scaleType="center"
            android:layout_height="@dimen/key_height_firstrow"
            android:padding="@dimen/padding_firstrow"

            android:src="@drawable/ic_menu_manage"
            />

    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/input_last_layout"
        android:background="@drawable/a_23_mf_theme_23_background_keyboard"
        android:orientation="horizontal"
        >

    </LinearLayout>


    <com.kurdikeyboard.KKeyboardView
        xmlns:android="http://schemas.android.com/apk/res/android"
        android:id="@+id/keyboard"

        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:verticalCorrection="0dp"


        android:keyPreviewLayout="@xml/a_1_mf_theme_preview"

        android:keyPreviewHeight="@dimen/samsung_key_height_popup"



        android:keyPreviewOffset="0dp"

        android:popupLayout="@layout/popup_en"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:keyBackground="@drawable/a_23_mf_theme_23_background_key_selector"
        android:background="@drawable/a_23_mf_theme_23_background_keyboard"
        android:keyTextColor="#2f2886"

        android:keyTextSize="0dp"
        android:labelTextSize="0dp"


        />



</LinearLayout>
