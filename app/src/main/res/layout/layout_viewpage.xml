<?xml version="1.0" encoding="utf-8"?>
<!-- 2.0: guide pages with a bottom navigation bar -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/kk_bg"
    android:layoutDirection="rtl"
    android:orientation="vertical">

    <androidx.viewpager.widget.ViewPager
        android:id="@+id/viewpager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/kk_surface"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <Button
            android:id="@+id/guidePrev"
            style="@style/KK.Button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/guide_prev" />

        <TextView
            android:id="@+id/guidePage"
            style="@style/KK.Caption"
            android:layout_width="72dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textSize="15sp" />

        <Button
            android:id="@+id/guideNext"
            style="@style/KK.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/guide_next" />
    </LinearLayout>
</LinearLayout>
