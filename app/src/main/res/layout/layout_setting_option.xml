<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:gravity="center_horizontal"
    android:weightSum="1"
    >


    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_weight=".48"


        android:gravity="center_horizontal">
    <ImageView
        android:layout_width="@dimen/width_layout_option_Imageview"
        android:layout_height="@dimen/height_layout_option_Imageview"
        android:id="@+id/imageview1setting"
        android:background="@drawable/ready_sentences"
        />


    <ImageView
        android:layout_width="@dimen/width_layout_option_Imageview"
        android:layout_height="@dimen/height_layout_option_Imageview"
        android:id="@+id/imageview2setting"
        android:background="@drawable/clipboard_png"
        />


    <ImageView
        android:layout_width="@dimen/width_layout_option_Imageview"
        android:layout_height="@dimen/height_layout_option_Imageview"
        android:id="@+id/imageview3setting"
        android:background="@drawable/contacts_method_2"
        />

    </LinearLayout>


    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_weight=".48"
        android:gravity="center_horizontal">
        <ImageView
            android:layout_width="@dimen/width_layout_option_Imageview"
            android:layout_height="@dimen/height_layout_option_Imageview"
            android:id="@+id/imageview4setting"
            android:background="@drawable/setting_png"
            />


        <ImageView
            android:layout_width="@dimen/width_layout_option_Imageview"
            android:layout_height="@dimen/height_layout_option_Imageview"
            android:id="@+id/imageview5setting"
            android:background="@drawable/persianexit"
            />


        <ImageView
            android:layout_width="@dimen/width_layout_option_Imageview"
            android:layout_height="@dimen/height_layout_option_Imageview"
            android:id="@+id/imageview6setting"
            android:background="@drawable/contacts_method_1"
            />

    </LinearLayout>
</LinearLayout>