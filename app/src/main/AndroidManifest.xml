<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.kurdikeyboard"
    android:versionName="1.5.6"
    android:versionCode="156">

    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.READ_USER_DICTIONARY" />

     <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.WRITE_CONTACTS" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />

    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.GET_CLIPS" />
    <uses-permission android:name="android.permission.READ_CLIPS" />
    <uses-permission android:name="android.permission.WRITE_CLIPS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

      <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"

        android:theme="@style/AppTheme"

        >
        <service
            android:name=".kurdikeyboard"
            android:permission="android.permission.BIND_INPUT_METHOD"
            android:windowSoftInputMode="adjustResize"

            >
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>

            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>
        <service android:name=".CBWatcherService"
             />

        <activity
            android:name=".ImePreferences"
            android:label="@string/app_name"
            android:theme="@android:style/Theme.Light">
            <intent-filter>
                <action android:name="com.KurdiKeyboard.ImePreferences" />

                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity android:name=".MainActivity"
            android:theme="@android:style/Theme.Light">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".Main2Activity"
            android:theme="@android:style/Theme.Light"/>
        <activity android:name=".Main22Activity"
            android:theme="@android:style/Theme.Light">

        </activity>
          <activity android:name=".UpdatePage"
              android:theme="@android:style/Theme.Light"/>

          <activity android:name=".MainActivityViewPager"
              android:screenOrientation="portrait"
              android:configChanges="orientation|keyboardHidden"
              android:theme="@android:style/Theme.Light"/>

          <activity android:name=".ImagePickerActivity"
              android:theme="@android:style/Theme.Light"
              android:permission="android.permission.READ_EXTERNAL_STORAGE"/>



      </application>

</manifest>